{
  "name": "breakmine",
  "version": "1.0.0",
  "description": "Minecraft in javascript",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start-dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "devs:https": "vite",
    "devs:http": "vite --config vite.http.config.js",
    "devs:all": "concurrently \"npm run devs:https\" \"npm run devs:http\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1",
    "server": "node server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/BreakmineDevelopers/breakmine_revived.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://codeberg.org/BreakmineDevelopers/breakmine_revived/issues"
  },
  "homepage": "https://codeberg.org/BreakmineDevelopers/breakmine_revived#readme",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.6.0",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.3",
    "uuid": "^10.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "vite": "^8.1.3",
    "vite-plugin-mkcert": "^2.1.0",
    "wait-on": "^9.1.0"
  }
}
